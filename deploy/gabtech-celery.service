[Unit]
Description=GabTech Celery worker (provisionamento)
After=network.target redis-server.service postgresql.service gabtech-api.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/gabtech/backend
EnvironmentFile=/var/www/gabtech/backend/.env
ExecStart=/var/www/gabtech/backend/.venv/bin/celery -A config worker -l info -Q default -c 2
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
