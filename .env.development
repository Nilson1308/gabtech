# --- Multi-tenant (recomendado) ---
# Não defina VITE_API_BASE_URL: o front usa o mesmo host do navegador
# (ex.: gab-edsonsantos.localhost:5174 → API gab-edsonsantos.localhost:8800).
# Para forçar sempre o demo, descomente:
# VITE_API_BASE_URL=http://demo.localhost:8800

# API schema public (cadastro self-service) — 127.0.0.1 evita cair no tenant do host "localhost"
VITE_PLATFORM_API_BASE_URL=http://127.0.0.1:8800
VITE_TENANT_DOMAIN_SUFFIX=localhost
VITE_API_PORT=8800
