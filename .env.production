# Copie para .env.production (build) ou configure no CI/CD
# URLs públicas — ajuste para seu domínio

# Deixe vazio para resolver API pelo hostname do navegador (recomendado multi-tenant)
# VITE_API_BASE_URL=

# API do schema public (cadastro de gabinetes)
VITE_PLATFORM_API_BASE_URL=https://api.gabtech.app.br
VITE_TENANT_DOMAIN_SUFFIX=gabtech.app.br
VITE_API_PORT=443

# Exibe campo "código de convite" no cadastro (deve ser igual ao backend)
VITE_SIGNUP_CODIGO_CONVITE=gab-tech-2026
