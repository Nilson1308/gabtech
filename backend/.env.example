DJANGO_SECRET_KEY=troque-em-producao
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Dev com Docker: cp .env.example .env && docker compose up -d
POSTGRES_DB=gabtech
POSTGRES_USER=gabtech
POSTGRES_PASSWORD=gabtech
POSTGRES_HOST=localhost
# 5433 = container gabtech-postgres (docker-compose.yml); 5432 = Postgres do SO
POSTGRES_PORT=5433

SHOW_PUBLIC_IF_NO_TENANT_FOUND=true

# Porta do runserver local (./serve.sh ou manage.py runserver 0.0.0.0:$DJANGO_DEV_PORT)
DJANGO_DEV_PORT=8800

# Origens do Vite (separadas por vírgula). Subdomínios *.localhost:porta já entram via regex em settings.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://demo.localhost:5174

# Self-service — cadastro de gabinetes (schema public)
GABTECH_SIGNUP_ENABLED=true
# GABTECH_SIGNUP_CODIGO_CONVITE=seu-codigo-dev
GABTECH_TENANT_DOMAIN_SUFFIX=localhost
GABTECH_TENANT_API_PORT=8800
GABTECH_TENANT_APP_PORT=5174

# Admin plataforma (schema public): http://localhost:8800/admin/
# Criar operador: python manage.py criar_operador_plataforma --email=ops@... --senha=...
