# Copie para .env.development ou .env.local

# --- Multi-tenant (dev) ---
# Deixe VITE_API_BASE_URL comentado para testar qualquer gabinete pelo subdomínio:
#   http://<slug>.localhost:5174/login  →  API http://<slug>.localhost:8800
# VITE_API_BASE_URL=http://demo.localhost:8800

VITE_PLATFORM_API_BASE_URL=http://127.0.0.1:8800
VITE_TENANT_DOMAIN_SUFFIX=localhost
VITE_API_PORT=8800

# Opcional: exige código no formulário (deve bater com GABTECH_SIGNUP_CODIGO_CONVITE no backend)
# VITE_SIGNUP_CODIGO_CONVITE=
